{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main window: core APIs plus the app's own request/clipboard/save commands",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "allow-send-request",
    "allow-cancel-request",
    "allow-copy-text",
    "allow-save-file"
  ]
}
